# Conexión a la base de datos propia de esta instancia (una BD por cliente).
# Si el puerto 5432 está ocupado: DB_PORT=55442 docker compose up -d db y cambia aquí el puerto.
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot

# Credencial del operador. Genera el hash con: pnpm operator:hash-password
OPERATOR_USER=operador
OPERATOR_PASSWORD_HASH=

# Clave de la cookie de sesión: 32 bytes aleatorios en hex. Genérala con: openssl rand -hex 32
# (o node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"). Cambiarla cierra todas las sesiones.
SESSION_SECRET=

# Valores por defecto de la instancia.
DEFAULT_PHONE_REGION=ES
DEFAULT_TIMEZONE=Europe/Madrid
DEFAULT_CURRENCY=EUR

PORT=3000

# Proxies de confianza delante del servicio: número de saltos (p. ej. 1) o IP/CIDR separadas por comas.
# Vacío si no hay proxy. Nunca "true".
TRUST_PROXY=
NODE_ENV=development

# URL pública https de esta instancia (sin ruta), p. ej. https://chat.ejemplo.com. Opcional: se usa
# para escribir el fragmento del chat web; sin ella se toma del origen de la petición del panel.
PUBLIC_BASE_URL=

# --- Atención por WhatsApp (feature 002) -----------------------------------------------------
# Antes de usar datos reales hacen falta los contratos de encargado del tratamiento con Meta,
# Anthropic y, si se activan los audios, el proveedor de transcripción (research R10).

# WhatsApp Cloud API. Las cinco o ninguna: sin ellas la instancia arranca sin canal (solo panel).
WHATSAPP_PHONE_NUMBER_ID=
# Token de usuario de sistema de la app de Meta.
WHATSAPP_ACCESS_TOKEN=
# Secreto de la app: firma X-Hub-Signature-256 de los webhooks.
WHATSAPP_APP_SECRET=
# Texto aleatorio que se indica en Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API (p. ej. v23.0).
WHATSAPP_GRAPH_VERSION=

# Contacto de emergencia en E.164 (+34...). Obligatoria con ANTHROPIC_API_KEY. Solo se usa cuando
# no se puede leer la información del negocio (disculpa del bot y chat web "no disponible").
EMERGENCY_CONTACT_PHONE=

# Modelo de lenguaje. Basta esta clave para tener bot ("Probar el bot" y chat web); WhatsApp es
# opcional. Obligatoria si se configura WhatsApp.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Esfuerzo del modelo: low, medium o high.
LLM_EFFORT=medium

# Audios: off (por defecto) responde que solo se atiende texto; on los transcribe.
AUDIO_TRANSCRIPTION=off
# Solo con AUDIO_TRANSCRIPTION=on: clave y modelo de la API de transcripción.
STT_API_KEY=
STT_MODEL=whisper-1

# --- Avisos de derivación al negocio (feature 005) -------------------------------------------
# Los destinos (WhatsApp y email del negocio) se configuran en el panel, en "Derivaciones".

# Servidor SMTP para los avisos por email: smtps://usuario:clave@host:465 o smtp://usuario:clave@host:587
# (STARTTLS). Van las dos o ninguna. La vía email necesita además PUBLIC_BASE_URL (los enlaces
# «Le atiendo» y «Terminado» del email apuntan a esta instancia).
SMTP_URL=
# Remitente de los avisos, p. ej. avisos@ejemplo.com.
SMTP_FROM=
# Idioma de las plantillas de WhatsApp de los avisos (xx o xx_XX). La vía WhatsApp necesita las
# tres plantillas aprobadas por Meta; su definición se imprime con: pnpm handoff:templates
WHATSAPP_TEMPLATE_LANG=es

# --- Copias de seguridad (feature 006) -------------------------------------------------------
# En production INSTANCE_ID, BACKUP_DIR y BACKUP_KEY son obligatorias: sin ellas la instancia no
# arranca. Fuera de production van las tres o ninguna; sin ellas no hay copia diaria y una
# migración pendiente con datos bloquea el arranque (no se migra sin copia previa).

# Identificador de la instancia (minúsculas, cifras y guiones), distinto por cliente, p. ej. demo-01.
INSTANCE_ID=
# Directorio absoluto de las copias: un volumen persistente escribible por la instancia.
BACKUP_DIR=
# Clave de cifrado de las copias: 32 bytes aleatorios en hex (openssl rand -hex 32), distinta de
# SESSION_SECRET y de la de otras instancias. Guárdala FUERA de BACKUP_DIR: sin ella las copias
# no se pueden restaurar.
BACKUP_KEY=
# Claves anteriores (solo lectura), separadas por comas, para restaurar copias hechas antes de
# cambiar BACKUP_KEY. Se pueden quitar cuando caduquen esas copias.
BACKUP_KEYS_PREVIOUS=
# Días que se conservan las copias (1–30). Siempre se conserva la última válida.
BACKUP_RETENTION_DAYS=7
# Hora local del negocio (HH:MM, 24 h) de la copia diaria automática.
BACKUP_DAILY_TIME=03:00
# Servidor PostgreSQL donde pnpm db:verify crea la BD temporal (usuario con CREATEDB).
# Vacío = el de DATABASE_URL.
BACKUP_VERIFY_URL=

# --- Salud y versión (feature 009) -----------------------------------------------------------
# Secreto de salud propio de esta instancia: 32 bytes aleatorios en hex (openssl rand -hex 32),
# distinto de SESSION_SECRET, de BACKUP_KEY y del de cualquier otra instancia. Quien lo envía como
# "Authorization: Bearer <secreto>" ve en GET /health la versión del núcleo y del esquema; sin él,
# /health solo responde el estado. pnpm instance:new lo genera y pnpm instance:check lo exige.
HEALTH_SECRET=
