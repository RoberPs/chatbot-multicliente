  <button id="chat-toggle" type="button" class="toggle" aria-expanded="false" aria-controls="chat-panel">
    <% if (it.theme.images.icon) { %><img class="design-icon" src="<%= it.theme.images.icon %>" alt=""><% } %>
    <span aria-hidden="true">💬</span>
    <span class="sr-only">Abrir el chat</span>
  </button>
