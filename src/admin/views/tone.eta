<% layout('/layout') %>
<% const v = it.values; const e = it.errors; %>
<%~ include('/partials/general-error', { errors: it.errors, general: it.general, blocking: it.blocking, h: it.h }) %>
<p class="hint">Cada negocio tiene una única configuración de tono. Al guardar, sustituye a la anterior.</p>
<form class="stack card" method="post" action="/admin/tone">
  <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
  <fieldset class="<%= e.address_form ? 'has-error' : '' %>">
    <legend>Tratamiento *</legend>
    <label class="checkbox"><input type="radio" name="address_form" value="informal"<% if (v.address_form === 'informal') { %> checked<% } %>> Tú</label>
    <label class="checkbox"><input type="radio" name="address_form" value="formal"<% if (v.address_form === 'formal') { %> checked<% } %>> Usted</label>
    <%~ include('/partials/field-error', { message: e.address_form }) %>
  </fieldset>
  <label class="<%= e.style_description ? 'has-error' : '' %>">Descripción del estilo
    <textarea name="style_description" maxlength="2000" placeholder="Cercano y breve, sin tecnicismos…"><%= it.h.str(v.style_description) %></textarea>
    <%~ include('/partials/field-error', { message: e.style_description }) %>
  </label>
  <div class="actions">
    <button type="submit">Guardar</button>
    <% if (it.state.tone) { %><span class="meta">Última modificación: <%= it.h.dateTime(it.state.tone.updatedAt, it.state.business.timezone) %></span><% } %>
  </div>
</form>
