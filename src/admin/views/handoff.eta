<% layout('/layout') %>
<% const v = it.values; const e = it.errors;
   const channels = Array.isArray(v.channels) ? v.channels : [];
   const own = it.warnings.filter(function (w) { return w.target.kind === 'handoff'; }); %>
<%~ include('/partials/general-error', { errors: it.errors, general: it.general, blocking: it.blocking, h: it.h }) %>
<% if (own.length > 0) { %><%~ include('/partials/warnings-list', { warnings: own, h: it.h, links: false }) %><% } %>
<%~ include('/partials/handoff-effective', { notice: it.handoffNotice }) %>
<p class="hint">Persona a la que el bot pasa la conversación cuando no puede resolverla.</p>
<p class="hint">Cada negocio tiene un único contacto de derivación, con uno o varios medios por orden de preferencia. Para añadir un medio, rellena la fila vacía o pulsa "Añadir medio". Para quitarlo, marca "Quitar" y guarda. Si quitas todos, el bot usará el teléfono del negocio.</p>
<form class="stack card" method="post" action="/admin/handoff">
  <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
  <fieldset>
    <legend>Medios de contacto (por orden de preferencia)</legend>
    <div id="channel-rows">
      <% channels.forEach(function (c, i) { %>
        <%~ include('/partials/channel-row', { index: i, type: c.type, value: c.value, removable: true, remove: c.remove, errors: e }) %>
      <% }) %>
      <%~ include('/partials/channel-row', { index: channels.length, type: 'phone', value: '', removable: false, errors: {} }) %>
    </div>
    <button type="button" class="link small" hx-get="/admin/partials/channel-row" hx-target="#channel-rows" hx-swap="beforeend">Añadir medio</button>
    <%~ include('/partials/field-error', { message: e.channels }) %>
  </fieldset>
  <fieldset>
    <legend>Horario de atención (opcional)</legend>
    <%~ include('/partials/weekly-slots', { prefix: 'slots', slots: v.slots, errors: e, h: it.h }) %>
  </fieldset>
  <div class="actions">
    <button type="submit">Guardar</button>
    <% if (it.state.handoff) { %><span class="meta">Última modificación: <%= it.h.dateTime(it.state.handoff.updatedAt, it.state.business.timezone) %></span><% } %>
  </div>
</form>
