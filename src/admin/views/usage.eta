<% layout('/layout') %>
<% const v = it.values; const e = it.errors; %>
<%~ include('/partials/general-error', { errors: it.errors, general: it.general, blocking: it.blocking, h: it.h }) %>
<p class="hint">Coste estimado con los precios configurados aquí. No es la factura del proveedor. Importes redondeados a 4 decimales. Los importes menores de 0,0001 se muestran como «&lt; 0,0001».</p>

<% if (it.monthUnavailable) { %>
  <p class="notice" role="status">Mes no disponible: se muestra el mes en curso.</p>
<% } %>

<% if (!it.botPresent) { %>
  <p class="notice" role="status">Esta instancia no tiene bot: no hay consumo.</p>
<% } else { %>
  <% if (it.unpricedModels.length > 0) { %>
    <div class="notice" role="status">
      <% it.unpricedModels.forEach(function (m) { %>
        <p>Consumo sin precio del modelo «<%= m %>»: sus tokens se muestran pero no tienen coste.</p>
      <% }) %>
    </div>
  <% } %>
  <% /* 017 (FR-024, FR-008): nota genérica. Dice «el modelo configurado», nunca el proveedor. */ %>
  <% if (it.noDataConcepts.length > 0 || it.unmeasuredCalls > 0) { %>
    <div class="notice" role="status" data-usage-no-data>
      <% if (it.noDataConcepts.length > 0) { %>
        <p>El modelo configurado no informa de <%= it.noDataConcepts.join(' ni de ') %>: ese dato sale como «sin dato», que no es cero, y no se suma como tal. El coste estimado no lo valora.</p>
      <% } %>
      <% if (it.unmeasuredCalls > 0) { %>
        <p><%= it.unmeasuredCalls %> <%= it.unmeasuredCalls === 1 ? 'llamada al modelo no informó' : 'llamadas al modelo no informaron' %> de su consumo: hubo consumo que no se ha podido valorar, y no fue gratis. Donde aparece, va junto a las respuestas con modelo.</p>
      <% } %>
    </div>
  <% } %>
  <% it.tables.forEach(function (table) { %>
    <section class="card usage">
      <h2><%= table.title %></h2>
      <% if (table.rows.length === 0) { %>
        <p class="meta">Sin consumo en este mes.</p>
      <% } else { %>
        <div class="table-scroll">
          <%~ include('/partials/usage-table', { id: table.id, first: table.first, rows: table.rows }) %>
        </div>
      <% } %>
    </section>
  <% }) %>
<% } %>

<% if (it.months.length > 0) { %>
<form class="card stack" method="get" action="/admin/usage">
  <h2>Meses anteriores</h2>
  <div>
    <label for="month">Mes</label>
    <select id="month" name="month">
      <% it.months.forEach(function (m) { %><option value="<%= m.value %>"<% if (m.selected) { %> selected<% } %>><%= m.label %></option><% }) %>
    </select>
    <span class="hint">Se conservan el mes en curso y los 12 anteriores.</span>
  </div>
  <div class="actions">
    <button type="submit" class="secondary">Ver mes</button>
    <a href="/admin/usage">Hoy y este mes</a>
  </div>
</form>
<% } %>

<section class="card" data-cap-level="<%= it.cap.level %>">
  <h2>Tope mensual</h2>
  <p>
    <span class="badge <%= it.cap.level === 'reached' ? 'badge-warn' : it.cap.level === 'none' ? 'badge-draft' : 'badge-ok' %>"><%= it.cap.label %></span>
    Gasto del mes: <%= it.cap.spent %> · Tope: <%= it.cap.cap || 'sin fijar' %><% if (it.cap.percent !== null) { %> · <%= it.cap.percent %> %<% } %>
  </p>
  <p class="hint">Común a todos los canales; incluye «Probar el bot», los resúmenes de derivación y las transcripciones de audios. Al alcanzarlo, el bot responde en WhatsApp y en el chat web solo con el contacto del negocio hasta el mes siguiente o hasta que subas el tope.</p>
  <p class="hint" data-cap-required>En producción el tope de gasto es obligatorio: sin él, o sin el precio del modelo actual, los clientes reciben solo el contacto del negocio y el negocio no se puede activar.</p>
</section>

<form class="stack card" method="post" action="/admin/usage/settings">
  <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
  <h2>Ajustes de coste</h2>
  <div>
    <label for="currency">Moneda de coste</label>
    <input id="currency" name="currency" type="text" maxlength="3" value="<%= it.h.str(v.currency) %>">
    <span class="hint">Código de 3 letras (USD, EUR…). Los precios están en esta moneda: para cambiarla, borra antes los precios.</span>
    <%~ include('/partials/field-error', { message: it.h.err(e, 'currency') }) %>
  </div>
  <div>
    <label for="monthlyCap">Tope mensual de gasto (<%= it.currency %>)</label>
    <input id="monthlyCap" name="monthlyCap" type="text" inputmode="decimal" value="<%= it.h.str(v.monthlyCap) %>">
    <%~ include('/partials/field-error', { message: it.h.err(e, 'monthlyCap') }) %>
  </div>
  <div>
    <label for="capEnabled" class="inline">
      <input id="capEnabled" name="capEnabled" type="checkbox"<% if (v.capEnabled) { %> checked<% } %>>
      Activar el tope
    </label>
    <span class="hint">Exige el precio del modelo actual («<%= it.currentModel %>»).</span>
    <%~ include('/partials/field-error', { message: it.h.err(e, 'capEnabled') }) %>
  </div>
  <div class="actions">
    <button type="submit">Guardar</button>
  </div>
</form>

<section class="card">
  <h2>Precios por modelo</h2>
  <p class="hint">Precios por millón de tokens, en <%= it.currency %>. Cambiar un precio no altera el coste de lo ya registrado.</p>
  <% if (!it.currentHasPrice) { %>
    <p class="notice" role="status">El modelo actual «<%= it.currentModel %>» no tiene precio. Añádelo abajo: el nombre ya está puesto.</p>
  <% } %>
  <% if (it.prices.length > 0) { %>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Modelo</th>
        <th scope="col">Entrada</th>
        <th scope="col">Salida</th>
        <th scope="col">Escritura en caché</th>
        <th scope="col">Lectura de caché</th>
        <th scope="col"><span class="visually-hidden">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% it.prices.forEach(function (p) { %>
      <tr>
        <th scope="row"><%= p.model %><% if (p.current) { %> <span class="badge badge-ok">modelo actual</span><% } %></th>
        <td><%= p.input %></td>
        <td><%= p.output %></td>
        <td><%= p.cacheWrite %></td>
        <td><%= p.cacheRead %></td>
        <td>
          <form class="inline" method="post" action="/admin/usage/prices/delete" hx-confirm="¿Eliminar el precio de <%= p.model %>? Lo ya registrado conserva su coste.">
            <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
            <input type="hidden" name="model" value="<%= p.model %>">
            <button type="submit" class="danger small">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>

  <form class="stack" method="post" action="/admin/usage/prices">
    <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
    <h3>Añadir o cambiar un precio</h3>
    <p class="hint">Para cambiar un precio, escribe el mismo nombre de modelo.</p>
    <div>
      <label for="model">Modelo</label>
      <input id="model" name="model" type="text" value="<%= it.h.str(v.model) %>" maxlength="200">
      <%~ include('/partials/field-error', { message: it.h.err(e, 'model') }) %>
    </div>
    <% [['input', 'Entrada'], ['output', 'Salida'], ['cacheWrite', 'Escritura en caché'], ['cacheRead', 'Lectura de caché']].forEach(function (f) { %>
    <div>
      <label for="<%= f[0] %>"><%= f[1] %> (<%= it.currency %> por millón de tokens)</label>
      <input id="<%= f[0] %>" name="<%= f[0] %>" type="text" inputmode="decimal" value="<%= it.h.str(v[f[0]]) %>">
      <%~ include('/partials/field-error', { message: it.h.err(e, f[0]) }) %>
    </div>
    <% }) %>
    <%~ include('/partials/field-error', { message: it.h.err(e, 'prices') }) %>
    <div class="actions">
      <button type="submit">Guardar precio</button>
    </div>
  </form>
</section>

<% if (it.whatsapp.show) { %>
<form class="stack card" method="post" action="/admin/usage/whatsapp-cap" data-section="whatsapp-cap">
  <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
  <h2>Tope diario de WhatsApp</h2>
  <p data-whatsapp-today>Respuestas con el modelo hoy: <%= it.whatsapp.today %> / <%= it.whatsapp.cap %></p>
  <p class="hint">Al llegar al tope, el bot responde por WhatsApp solo con el contacto del negocio hasta las 00:00 (hora del negocio). Las peticiones de hablar con una persona se siguen derivando.</p>
  <div>
    <label for="whatsappDailyCap">Respuestas con el modelo al día</label>
    <input id="whatsappDailyCap" name="whatsappDailyCap" type="text" inputmode="numeric" value="<%= it.h.str(v.whatsappDailyCap) %>">
    <%~ include('/partials/field-error', { message: it.h.err(e, 'whatsappDailyCap') }) %>
  </div>
  <div class="actions">
    <button type="submit">Guardar</button>
  </div>
</form>
<% } %>

<form class="stack card" method="post" action="/admin/usage/handoff-limits" data-section="handoff-limits">
  <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
  <h2>Límites de derivación</h2>
  <ul data-handoff-today>
    <li>Derivaciones nuevas hoy: <%= it.handoffs.today.started %> / <%= it.handoffs.limits.dailyMax %></li>
    <li>Peticiones sin aviso hoy: <%= it.handoffs.today.refused %></li>
    <li>Avisos al negocio hoy: <%= it.handoffs.today.notices %> / <%= it.handoffs.limits.noticesDailyMax %></li>
    <li>Avisos retenidos hoy: <%= it.handoffs.today.noticesHeld %></li>
  </ul>
  <p class="hint">Cuando se alcanza un límite, el cliente recibe el contacto del negocio en lugar del aviso. Lo que escribe durante una derivación se reenvía agrupado, como mucho una vez por intervalo. Los días cuentan en la hora del negocio.</p>
  <div>
    <label for="dailyMax">Derivaciones nuevas al día (1–200)</label>
    <input id="dailyMax" name="dailyMax" type="text" inputmode="numeric" value="<%= it.h.str(v.dailyMax) %>">
    <%~ include('/partials/field-error', { message: it.h.err(e, 'dailyMax') }) %>
  </div>
  <div>
    <label for="forwardIntervalMinutes">Minutos entre avisos de una derivación (5–240)</label>
    <input id="forwardIntervalMinutes" name="forwardIntervalMinutes" type="text" inputmode="numeric" value="<%= it.h.str(v.forwardIntervalMinutes) %>">
    <%~ include('/partials/field-error', { message: it.h.err(e, 'forwardIntervalMinutes') }) %>
  </div>
  <div>
    <label for="noticesDailyMax">Avisos al negocio al día (10–500)</label>
    <input id="noticesDailyMax" name="noticesDailyMax" type="text" inputmode="numeric" value="<%= it.h.str(v.noticesDailyMax) %>">
    <%~ include('/partials/field-error', { message: it.h.err(e, 'noticesDailyMax') }) %>
  </div>
  <div class="actions">
    <button type="submit">Guardar</button>
  </div>
</form>

<% if (it.transcription.show) { %>
<section class="card" data-section="transcription-prices">
  <h2>Precios de transcripción</h2>
  <p class="hint">Precio por minuto de audio, en <%= it.currency %>. Cada audio transcrito suma al gasto del mes.</p>
  <% if (it.transcription.sttModel !== null && !it.transcription.sttHasPrice) { %>
    <p class="notice" role="status">El modelo de transcripción «<%= it.transcription.sttModel %>» no tiene precio. Añádelo abajo: el nombre ya está puesto.</p>
  <% } %>
  <%~ include('/partials/field-error', { message: it.h.err(e, 'transcriptionPrices') }) %>
  <% if (it.transcription.prices.length > 0) { %>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th scope="col">Modelo</th>
        <th scope="col">Precio por minuto</th>
        <th scope="col"><span class="visually-hidden">Acciones</span></th>
      </tr>
    </thead>
    <tbody>
      <% it.transcription.prices.forEach(function (p) { %>
      <tr>
        <th scope="row"><%= p.model %><% if (p.current) { %> <span class="badge badge-ok">modelo actual</span><% } %></th>
        <td><%= p.perMinute %></td>
        <td>
          <form class="inline" method="post" action="/admin/usage/transcription-prices/<%= encodeURIComponent(p.model) %>/delete" hx-confirm="¿Eliminar el precio de <%= p.model %>? Lo ya registrado conserva su coste.">
            <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
            <button type="submit" class="danger small">Eliminar</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>

  <form class="stack" method="post" action="/admin/usage/transcription-prices">
    <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
    <h3>Añadir o cambiar un precio de transcripción</h3>
    <div>
      <label for="transcriptionModel">Modelo</label>
      <input id="transcriptionModel" name="model" type="text" value="<%= it.h.str(v.transcriptionModel) %>" maxlength="200">
      <%~ include('/partials/field-error', { message: it.h.err(e, 'transcriptionModel') }) %>
    </div>
    <div>
      <label for="perMinute">Precio por minuto (<%= it.currency %>)</label>
      <input id="perMinute" name="perMinute" type="text" inputmode="decimal" value="<%= it.h.str(v.perMinute) %>">
      <%~ include('/partials/field-error', { message: it.h.err(e, 'perMinute') }) %>
    </div>
    <div class="actions">
      <button type="submit">Guardar precio</button>
    </div>
  </form>
</section>
<% } %>
