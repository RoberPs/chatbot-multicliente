<% layout('/layout') %>
<% const v = it.values; const e = it.errors;
   const own = it.warnings.filter(function (w) { return w.target.kind === 'handoff_alerts'; }); %>
<%~ include('/partials/general-error', { errors: it.errors, general: it.general, blocking: it.blocking, h: it.h }) %>
<p class="hint">Cuando un cliente pide hablar con una persona, presenta una queja o acepta que le contacten, el asistente avisa al negocio por estas vías y deja de responder en esa conversación hasta que termina la derivación.</p>

<section class="card">
  <h2>Avisos al negocio</h2>
  <% if (own.length > 0) { %><%~ include('/partials/warnings-list', { warnings: own, h: it.h, links: false }) %><% } %>
  <ul class="route-status">
    <% it.routes.forEach(function (r) { %>
      <li data-route="<%= r.label %>" data-state="<%= r.state %>">
        <strong><%= r.label %>:</strong>
        <span class="badge <%= r.state === 'ok' ? 'badge-ok' : 'badge-draft' %>"><%= r.state === 'ok' ? 'Disponible' : r.state === 'none' ? 'Sin configurar' : 'No disponible' %></span>
        <% if (r.state === 'blocked') { %><span class="meta"><%= r.text %></span><% } %>
      </li>
    <% }) %>
  </ul>

  <form class="stack" method="post" action="/admin/handoffs/alerts">
    <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
    <div>
      <label for="whatsapp">WhatsApp para avisos</label>
      <input id="whatsapp" name="whatsapp" type="tel" value="<%= it.h.str(v.whatsapp) %>" placeholder="611 22 33 44">
      <span class="hint">El número del negocio que recibirá los avisos con los botones «Le atiendo» y «Terminado». Lo que escriba ese número al asistente no se trata como un cliente.</span>
      <%~ include('/partials/field-error', { message: it.h.err(e, 'whatsapp') }) %>
    </div>
    <div>
      <label for="email">Email para avisos</label>
      <input id="email" name="email" type="email" value="<%= it.h.str(v.email) %>" placeholder="avisos@minegocio.example">
      <%~ include('/partials/field-error', { message: it.h.err(e, 'email') }) %>
    </div>
    <div class="actions">
      <button type="submit">Guardar</button>
      <span class="meta">Los dos son opcionales: sin ninguna vía, el bot da el contacto de derivación.</span>
    </div>
  </form>
</section>

<section class="card">
  <h2>Derivaciones activas</h2>
  <% if (it.active.length === 0) { %>
    <p class="meta">No hay ninguna conversación derivada ahora mismo.</p>
  <% } else { %>
    <table class="handoffs">
      <thead>
        <tr><th scope="col">Cliente</th><th scope="col">Canal</th><th scope="col">Tipo</th><th scope="col">Inicio</th><th scope="col">Confirmada</th><th scope="col">Recordatorio enviado</th><th scope="col">Pendientes de reenviar</th><th scope="col"><span class="sr-only">Acciones</span></th></tr>
      </thead>
      <tbody>
        <% it.active.forEach(function (r) { %>
          <tr id="handoff-<%= r.id %>" data-handoff="<%= r.id %>">
            <td><%= r.customer %></td>
            <td><%= r.channel %></td>
            <td><%= r.kind %></td>
            <td><%= r.startedAt %></td>
            <td><%= r.confirmed %></td>
            <td><%= r.reminder %></td>
            <td data-pending="<%= r.pending %>"><%= r.pendingText || '—' %></td>
            <td>
              <form method="post" action="/admin/handoffs/<%= r.id %>/end"
                    hx-post="/admin/handoffs/<%= r.id %>/end" hx-target="closest tr" hx-swap="outerHTML"
                    hx-confirm="El asistente volverá a atender a este cliente. ¿Terminar la derivación?">
                <%~ include('/partials/csrf', { token: it.layout.csrf }) %>
                <button type="submit" class="secondary">Terminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="meta">El motivo de cada derivación solo lo recibe el negocio en su aviso. Lo que el cliente escribe durante la derivación se reenvía agrupado, como mucho un aviso cada intervalo (se ajusta en «Consumo» → «Límites de derivación»).</p>
  <% } %>
</section>

<section class="card">
  <h2>Mensajes retenidos</h2>
  <% if (it.held.length === 0) { %>
    <p class="meta">No hay mensajes retenidos.</p>
  <% } else { %>
    <p class="hint">Mensajes que el cliente escribió mientras esperaban su reenvío agrupado y que no llegaron al negocio porque la derivación terminó antes. El asistente no los contesta.</p>
    <table class="handoffs" data-held-list>
      <thead>
        <tr><th scope="col">Cliente</th><th scope="col">Canal</th><th scope="col">Retenido (no reenviado)</th><th scope="col">Último</th></tr>
      </thead>
      <tbody>
        <% it.held.forEach(function (r) { %>
          <tr data-held-conversation="<%= r.conversationId %>">
            <td><%= r.customer %></td>
            <td><%= r.channel %></td>
            <td><%= r.held %></td>
            <td><%= r.lastAt %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
