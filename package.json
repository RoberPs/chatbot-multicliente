{
  "name": "chatbotasesor",
  "version": "0.1.1",
  "private": true,
  "description": "Núcleo del chatbot de WhatsApp para pequeños negocios: base de conocimiento y panel del operador",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/server.js",
    "test": "vitest run --project unit --project contract --project integration",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:eval": "vitest run --project eval",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:backup": "tsx src/cli/backup.ts",
    "db:restore": "tsx src/cli/restore.ts",
    "db:verify": "tsx src/cli/verify.ts",
    "db:backups": "tsx src/cli/backups.ts",
    "kb:snapshot": "tsx src/cli/snapshot.ts",
    "bot:chat": "tsx src/cli/bot-chat.ts",
    "handoff:templates": "tsx src/cli/handoff-templates.ts",
    "operator:hash-password": "tsx src/cli/hash-password.ts",
    "instance:check": "tsx src/cli/instance.ts check",
    "instance:new": "tsx src/cli/instance.ts new",
    "instance:db": "tsx src/cli/instance.ts db",
    "instance:list": "tsx src/cli/instance.ts list",
    "instance:register": "tsx src/cli/instance.ts register",
    "instance:sync": "tsx src/cli/instance.ts sync",
    "instance:update": "tsx src/cli/instance.ts update",
    "instance:verified": "tsx src/cli/instance.ts verified",
    "instance:retire": "tsx src/cli/instance.ts retire",
    "instance:versions": "tsx src/cli/instance.ts versions",
    "instance:health-secret": "tsx src/cli/instance.ts health-secret"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.4.0",
    "@fastify/view": "^12.0.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "eta": "^4.6.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "htmx.org": "^2.0.11",
    "libphonenumber-js": "^1.13.13",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ]
  }
}
